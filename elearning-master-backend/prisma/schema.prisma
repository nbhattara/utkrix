generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

enum Role {
  student
  instructor
  admin
  moderator
}

enum Tier {
  free
  premium
}

enum SupportChannel {
  admin
  moderator
  support
}

enum SupportSender {
  guest
  user
  staff
}

enum StatsSource {
  manual
  users
  students
  instructors
  courses
  publishedCourses
  projects
  publishedProjects
  teamMembers
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(student)
  tier          Tier      @default(free)
  avatar        String?
  emailVerified Boolean   @default(false) @map("email_verified")
  tokenVersion  Int       @default(0) @map("token_version")
  isActive      Boolean   @default(true) @map("is_active")
  isApproved    Boolean   @default(false) @map("is_approved")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  courses               Course[]                     @relation("InstructorCourses")
  classroomEnrollments  CourseEnrollment[]           @relation("ClassroomStudent")
  lessonProgress        CourseLessonProgress[]
  assignmentSubmissions CourseAssignmentSubmission[]
  certificates          CourseCertificate[]
  notifications         Notification[]
  supportConversations  SupportConversation[]        @relation("SupportConversationOwner")
  supportMessages       SupportMessage[]             @relation("SupportMessageSender")
  authTokens            AuthToken[]
  oauthAccounts         OAuthAccount[]
  refreshTokens         RefreshToken[]

  @@map("users")
}

model Course {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @db.Text
  category     String
  instructorId Int
  thumbnail    String?
  price        Decimal  @db.Decimal(10, 2)
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  joinCode     String?  @unique @map("join_code") @db.VarChar(12)

  instructor    User                 @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrollments   CourseEnrollment[]
  announcements CourseAnnouncement[]
  materials     CourseMaterial[]
  assignments   CourseAssignment[]
  modules       CourseModule[]
  certificates  CourseCertificate[]

  @@map("courses")
}

model CourseEnrollment {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  studentId Int      @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("ClassroomStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, createdAt])
  @@map("course_enrollments")
}

model CourseAnnouncement {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  title     String   @db.VarChar(150)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@map("course_announcements")
}

model CourseMaterial {
  id               Int      @id @default(autoincrement())
  courseId         Int      @map("course_id")
  kind             String   @default("note") @db.VarChar(20)
  title            String   @db.VarChar(150)
  description      String?  @db.Text
  url              String?  @db.VarChar(2048)
  attachmentKey    String?  @map("attachment_key") @db.VarChar(191)
  originalFileName String?  @map("original_file_name") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@map("course_materials")
}

model CourseAssignment {
  id               Int       @id @default(autoincrement())
  courseId         Int       @map("course_id")
  moduleId         Int?      @map("module_id")
  title            String    @db.VarChar(150)
  instructions     String    @db.Text
  dueAt            DateTime? @map("due_at")
  attachmentKey    String?   @map("attachment_key") @db.VarChar(191)
  originalFileName String?   @map("original_file_name") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  course      Course                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule?                @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  submissions CourseAssignmentSubmission[]

  @@index([courseId, dueAt])
  @@index([moduleId])
  @@map("course_assignments")
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  title       String   @db.VarChar(150)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]
  assignments CourseAssignment[]

  @@unique([courseId, sortOrder])
  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseLesson {
  id               Int      @id @default(autoincrement())
  moduleId         Int      @map("module_id")
  title            String   @db.VarChar(150)
  content          String   @db.Text
  videoUrl         String?  @map("video_url") @db.VarChar(2048)
  resourceUrl      String?  @map("resource_url") @db.VarChar(2048)
  attachmentKey    String?  @map("attachment_key") @db.VarChar(191)
  originalFileName String?  @map("original_file_name") @db.VarChar(255)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  module   CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress CourseLessonProgress[]

  @@unique([moduleId, sortOrder])
  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

model CourseLessonProgress {
  id          Int      @id @default(autoincrement())
  lessonId    Int      @map("lesson_id")
  studentId   Int      @map("student_id")
  completedAt DateTime @default(now()) @map("completed_at")

  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, completedAt])
  @@map("course_lesson_progress")
}

model CourseAssignmentSubmission {
  id           Int       @id @default(autoincrement())
  assignmentId Int       @map("assignment_id")
  studentId    Int       @map("student_id")
  response     String    @db.Text
  grade        Decimal?  @db.Decimal(6, 2)
  feedback     String?   @db.Text
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  gradedAt     DateTime? @map("graded_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  assignment CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
  @@map("course_assignment_submissions")
}

model CourseCertificate {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  studentId Int      @map("student_id")
  code      String   @unique @db.VarChar(64)
  issuedAt  DateTime @default(now()) @map("issued_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, issuedAt])
  @@map("course_certificates")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(150)
  body      String    @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(150)
  description String   @db.Text
  category    String   @db.VarChar(80)
  imageUrl    String?  @map("image_url") @db.VarChar(2048)
  projectUrl  String?  @map("project_url") @db.VarChar(2048)
  tags        Json?
  isFeatured  Boolean  @default(false) @map("is_featured")
  isPublished Boolean  @default(false) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("projects")
}

model Faq {
  id           Int      @id @default(autoincrement())
  question     String   @db.VarChar(500)
  answer       String   @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isPublished, displayOrder])
  @@map("faqs")
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  title        String   @db.VarChar(120)
  bio          String?  @db.Text
  photoUrl     String?  @map("photo_url") @db.VarChar(2048)
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isPublished, displayOrder])
  @@map("team_members")
}

model StatsMetric {
  id           Int         @id @default(autoincrement())
  label        String      @db.VarChar(100)
  source       StatsSource @default(manual)
  manualValue  String?     @map("manual_value") @db.VarChar(50)
  prefix       String      @default("") @db.VarChar(20)
  suffix       String      @default("") @db.VarChar(20)
  displayOrder Int         @default(0) @map("display_order")
  isPublished  Boolean     @default(false) @map("is_published")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  @@index([isPublished, displayOrder])
  @@map("stats_metrics")
}

model ContactMessage {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100)
  email               String    @db.VarChar(254)
  phone               String?   @db.VarChar(16)
  subject             String    @db.VarChar(150)
  message             String    @db.Text
  emailSentAt         DateTime? @map("email_sent_at")
  emailDeliveryFailed Boolean   @default(false) @map("email_delivery_failed")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

model SupportConversation {
  id                Int            @id @default(autoincrement())
  channel           SupportChannel
  userId            Int?           @map("user_id")
  guestIdentityHash String?        @map("guest_identity_hash") @db.Char(64)
  guestName         String?        @map("guest_name") @db.VarChar(100)
  guestEmail        String?        @map("guest_email") @db.VarChar(254)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at")

  owner    User?            @relation("SupportConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@unique([userId, channel])
  @@unique([guestIdentityHash, channel])
  @@index([channel, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id                 Int           @id @default(autoincrement())
  conversationId     Int           @map("conversation_id")
  senderUserId       Int?          @map("sender_user_id")
  senderType         SupportSender @map("sender_type")
  senderName         String        @map("sender_name") @db.VarChar(100)
  body               String        @db.Text
  notificationSentAt DateTime?     @map("notification_sent_at")
  notificationFailed Boolean       @default(false) @map("notification_failed")
  createdAt          DateTime      @default(now()) @map("created_at")

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("support_messages")
}

model AuthToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  purpose   String   @db.VarChar(32)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model OAuthAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id") @db.VarChar(191)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  replacedBy Int?    @map("replaced_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.VarChar(100)
  result      String   @db.VarChar(32)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}
