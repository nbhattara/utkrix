PORT=5000

MYSQL_URL=mysql://USER:PASSWORD@127.0.0.1:3306/utkrix

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=USER
DB_PASSWORD=PASSWORD
DB_DATABASE=utkrix

JWT_SECRET=your_secure_jwt_secret_min_32_bytes
JWT_ACCESS_SECRET=your_access_secret_min_32_bytes
JWT_REFRESH_SECRET=your_refresh_secret_min_32_bytes

NODE_ENV=development
LOG_LEVEL=info

# CORS Origins (comma-separated, no spaces)
# Development: http://localhost:5173,http://localhost:3000
# Production: https://utkrixtech.com,https://www.utkrixtech.com,https://login.utkrixtech.com,https://employees.utkrixtech.com,https://admin.utkrixtech.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookie Configuration
# Development: leave empty or use localhost
# Production: .utkrixtech.com (for cross-subdomain auth)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Domain Configuration
AUTH_DOMAIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=Utkrista Shikshya <your-gmail-address@gmail.com>
EMAIL_BRAND_NAME=UtkriX Technologies
CONTACT_TO=
OAUTH_CALLBACK_BASE_URL=http://localhost:5000/api/v1/auth/oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 Storage (S3-compatible)
# Leave empty for local-disk fallback in development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=utkrix-public
R2_PRIVATE_BUCKET=utkrix-private
R2_PUBLIC_URL=
