# API Configuration
# Dev: "/" uses the Vite /api proxy (API_PROXY_TARGET, default http://localhost:5000).
# Production: absolute URL, e.g. https://api.abc.com
VITE_API_URL=/
API_PROXY_TARGET=http://localhost:5000

# Domain Configuration (for redirects)
# Dev uses *.localhost subdomains; production uses https://abc.com, login.abc.com, etc.
VITE_MAIN_SITE_URL=http://abc.lvh.me:5173
VITE_EMPLOYEES_URL=http://employees.lvh.me:5173
VITE_ADMIN_URL=http://admin.lvh.me:5173
