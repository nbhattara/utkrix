VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:5000

# Subdomain app URLs (local dev uses plain localhost ports; browsers share
# localhost cookies across ports so SSO works without subdomains).
# Production equivalents:
#   VITE_API_BASE_URL=https://api.utkrixtech.com/api/v1
#   VITE_MAIN_SITE_URL=https://www.utkrixtech.com
#   VITE_LOGIN_URL=https://www.utkrixtech.com
#   VITE_EMPLOYEES_URL=https://employees.utkrixtech.com
#   VITE_ADMIN_URL=https://admin.utkrixtech.com
VITE_API_URL=http://localhost:5000
VITE_MAIN_SITE_URL=http://localhost:5173
VITE_LOGIN_URL=http://localhost:5174
VITE_EMPLOYEES_URL=http://localhost:5175
VITE_ADMIN_URL=http://localhost:5175
