# API Configuration
# Dev: "/" uses the Vite /api proxy (API_PROXY_TARGET, default http://localhost:5000).
# Production: VITE_API_URL=https://api.utkrixtech.com
VITE_API_URL=/
API_PROXY_TARGET=http://localhost:5000

# Domain Configuration (for redirects)
# Dev uses plain localhost ports; production uses
# https://www.utkrixtech.com, https://employees.utkrixtech.com, etc.
VITE_MAIN_SITE_URL=http://localhost:5173
VITE_EMPLOYEES_URL=http://localhost:5175
VITE_ADMIN_URL=http://localhost:5175
